# Default model pulled by the pull-model sidecar and used by the API.
HERDING_CATS_MODEL=llama3.1:8b

# Pipeline mode for the `test` container: `fast` (default) or `all`
# (runs the slow grounding tests too — adds many minutes).
HERDING_CATS_PIPELINE_MODE=fast

# Threshold for the slow grounding tests, in [0, 1]. Default 0.5.
HERDING_CATS_GROUNDING_THRESHOLD=0.5
